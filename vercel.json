{
  "buildCommand": "npm run build && npm run build:vercel-api",
  "outputDirectory": "dist",
  "framework": "vite",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "functions": {
    "api/index.cjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/auth/:path*", "destination": "/api" },
    { "source": "/orgs", "destination": "/api" },
    { "source": "/orgs/:path*", "destination": "/api" },
    { "source": "/customers", "destination": "/api" },
    { "source": "/customers/:path*", "destination": "/api" },
    { "source": "/invoices", "destination": "/api" },
    { "source": "/invoices/:path*", "destination": "/api" },
    { "source": "/sequences", "destination": "/api" },
    { "source": "/sequences/:path*", "destination": "/api" },
    { "source": "/payments", "destination": "/api" },
    { "source": "/payments/:path*", "destination": "/api" },
    { "source": "/webhooks", "destination": "/api" },
    { "source": "/webhooks/:path*", "destination": "/api" },
    { "source": "/public", "destination": "/api" },
    { "source": "/public/:path*", "destination": "/api" },
    { "source": "/storage", "destination": "/api" },
    { "source": "/storage/:path*", "destination": "/api" },
    { "source": "/ai", "destination": "/api" },
    { "source": "/ai/:path*", "destination": "/api" },
    { "source": "/api/:path*", "destination": "/api" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
