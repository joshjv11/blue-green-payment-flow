{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/health", "destination": "https://blue-green-payment-flow.onrender.com/health" },
    { "source": "/auth/:path*", "destination": "https://blue-green-payment-flow.onrender.com/auth/:path*" },
    { "source": "/orgs/:path*", "destination": "https://blue-green-payment-flow.onrender.com/orgs/:path*" },
    { "source": "/customers/:path*", "destination": "https://blue-green-payment-flow.onrender.com/customers/:path*" },
    { "source": "/invoices/:path*", "destination": "https://blue-green-payment-flow.onrender.com/invoices/:path*" },
    { "source": "/sequences/:path*", "destination": "https://blue-green-payment-flow.onrender.com/sequences/:path*" },
    { "source": "/payments/:path*", "destination": "https://blue-green-payment-flow.onrender.com/payments/:path*" },
    { "source": "/webhooks/:path*", "destination": "https://blue-green-payment-flow.onrender.com/webhooks/:path*" },
    { "source": "/public/:path*", "destination": "https://blue-green-payment-flow.onrender.com/public/:path*" },
    { "source": "/storage/:path*", "destination": "https://blue-green-payment-flow.onrender.com/storage/:path*" },
    { "source": "/ai/:path*", "destination": "https://blue-green-payment-flow.onrender.com/ai/:path*" },
    { "source": "/api/:path*", "destination": "https://blue-green-payment-flow.onrender.com/api/:path*" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
